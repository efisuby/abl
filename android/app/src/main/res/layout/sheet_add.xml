<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_16">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_16"
        android:text="@string/library_add"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheetFolder"
        style="@style/Widget.Abl.SheetRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/library_import_folder"
        app:icon="@drawable/ic_folder" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheetFile"
        style="@style/Widget.Abl.SheetRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/library_import_file"
        app:icon="@drawable/ic_audio_file" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sheetCloud"
        style="@style/Widget.Abl.SheetRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/library_add_cloud"
        app:icon="@drawable/ic_cloud" />
</LinearLayout>
